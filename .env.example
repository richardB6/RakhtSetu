# Database
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<db-name>?retryWrites=true&w=majority

# JWT Secrets
JWT_ACCESS_SECRET=replace-with-a-random-32-character-or-longer-secret
JWT_REFRESH_SECRET=replace-with-a-random-32-character-or-longer-secret

# App
NODE_ENV=production
DEMO_MODE=false
SEED_ON_STARTUP=false
NEXT_PUBLIC_APP_URL=https://your-production-domain.example.com
NEXT_PUBLIC_APP_NAME=RakthSetu
NEXT_PUBLIC_MAP_TILE_URL=https://{s}.basemaps.cartocdn.com/light_all/{z}/{x}/{y}{r}.png
NEXT_PUBLIC_MAP_ATTRIBUTION=&copy; <a href='https://www.openstreetmap.org/copyright'>OpenStreetMap</a> &copy; <a href='https://carto.com/attributions'>CARTO</a>

# Seed access (only for development/demo use)
SEED_SECRET=replace-with-a-random-32-character-or-longer-seed-secret
